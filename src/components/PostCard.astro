---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'articles'>;
}
const { post } = Astro.props;
const url = `/articles/${post.id}/`;
const date = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---
<article class="post-card">
  <h2 class="post-card__title"><a href={url}>{post.data.title}</a></h2>
  <div class="post-card__meta">
    <time datetime={post.data.date.toISOString()}>{date}</time>
    {post.data.tags.map((t) => <a class="tag" href={`/tags/${t}/`}>#{t}</a>)}
  </div>
  {post.data.summary && <p class="post-card__summary">{post.data.summary}</p>}
</article>
