---
import '../styles/main.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Apply theme before paint to avoid a flash of the wrong colors.
      const saved = localStorage.getItem('theme');
      const system = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = saved ?? (system ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">hihihi198</a>
      <nav class="nav">
        <a href="/">Blog</a>
        <a href="/diary/">Diary</a>
        <a href="/tags/">Tags</a>
      </nav>
      <button id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <span class="moon">☾</span>
        <span class="sun">☀</span>
      </button>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">© hihihi198</footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
